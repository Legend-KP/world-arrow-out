{
    "name": "world-arrow-out",
    "version": "1.0.0",
    "description": "World Arrow Out — World App mini game (Next.js + Unity bridge, Firebase, Cloudflare).",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build:cloudflare": "pnpm --filter @world-arrow-out/react-app exec opennextjs-cloudflare build",
        "deploy:only": "pnpm --filter @world-arrow-out/react-app exec opennextjs-cloudflare deploy",
        "upload:only": "pnpm --filter @world-arrow-out/react-app exec opennextjs-cloudflare upload",
        "preview:cloudflare": "pnpm --filter @world-arrow-out/react-app run preview",
        "deploy:cloudflare": "pnpm --filter @world-arrow-out/react-app run deploy",
        "upload:cloudflare": "pnpm --filter @world-arrow-out/react-app run upload",
        "deploy": "pnpm run deploy:cloudflare"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Legend-KP/world-arrow-out.git"
    },
    "bugs": {
        "url": "https://github.com/Legend-KP/world-arrow-out/issues"
    },
    "homepage": "https://github.com/Legend-KP/world-arrow-out#readme",
    "workspaces": [
        "packages/*",
        "hardhat/*"
    ],
    "keywords": [
        "world-app",
        "minikit",
        "nextjs",
        "firebase",
        "cloudflare"
    ],
    "dependencies": {
        "@tanstack/react-query": "^5.100.5",
        "axios": "^1.16.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "ethers": "^6.16.0",
        "firebase": "^12.12.1",
        "firebase-admin": "^13.8.0",
        "nanoid": "^5.1.11",
        "viem": "2.21.34",
        "wagmi": "2.10.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.19.3",
        "@types/node": "^22.19.17",
        "eslint": "^9.39.4",
        "typescript": "^6.0.3",
        "wrangler": "^4.84.1"
    },
    "pnpm": {
        "overrides": {
            "jose": "^5.9.6",
            "react": "18.3.1",
            "react-dom": "18.3.1"
        }
    }
}
