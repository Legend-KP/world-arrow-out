# Copy to .dev.vars for local Cloudflare Workers preview (wrangler).
# These mirror server-side secrets from the repo root .env — do not commit .dev.vars.

NEXTJS_ENV=development
NEXT_PRIVATE_MINIMAL_MODE=1

# Firebase Realtime Database secret (server-side only)
FIREBASE_DATABASE_SECRET=

# Optional payment override
WORLD_RECEIVING_WALLET=
