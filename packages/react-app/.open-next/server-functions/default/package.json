{
    "name": "celo-composer-minipay-template",
    "version": "1.0.0",
    "description": "Custom Celo Composer project.",
    "private": true,
    "author": "Celo",
    "license": "MIT",
    "scripts": {
        "build:cloudflare": "pnpm --filter @examples/react-app build",
        "preview:cloudflare": "pnpm --filter @examples/react-app preview",
        "deploy:cloudflare": "pnpm --filter @examples/react-app deploy",
        "upload:cloudflare": "pnpm --filter @examples/react-app upload"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/celo-org/celo-composer.git"
    },
    "bugs": {
        "url": "https://github.com/celo-org/celo-composer/issues"
    },
    "homepage": "https://github.com/celo-org/celo-composer/blob/main/README.md",
    "workspaces": [
        "packages/*",
        "hardhat/*"
    ],
    "keywords": [
        "celo-composer",
        "celo"
    ],
    "dependencies": {
        "@tanstack/react-query": "^5.100.5",
        "axios": "^1.16.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "ethers": "^6.16.0",
        "firebase": "^12.12.1",
        "firebase-admin": "^13.8.0",
        "nanoid": "^5.1.11",
        "viem": "2.21.34",
        "wagmi": "2.10.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.19.3",
        "@types/node": "^22.19.17",
        "eslint": "^9.39.4",
        "typescript": "^6.0.3"
    },
    "pnpm": {
        "overrides": {
            "jose": "^5.9.6",
            "react": "18.3.1",
            "react-dom": "18.3.1"
        }
    }
}
