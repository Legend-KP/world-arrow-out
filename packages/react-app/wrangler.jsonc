{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "world-arrow-out",
    "main": ".open-next/worker.js",
    "compatibility_date": "2024-12-30",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "keep_vars": true,
    "vars": {
        "NEXT_PRIVATE_MINIMAL_MODE": "1"
    },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "world-arrow-out"
        }
    ]
}

// Required Cloudflare secrets (Dashboard → Workers → Settings → Variables):
//   FIREBASE_DATABASE_SECRET   — Realtime Database secret from Firebase Console
//   DEV_PORTAL_API_KEY         — World Developer Portal API key (Pay verification)
//   WORLD_RECEIVING_WALLET     — optional runtime override for payments
//
// Build-time env (must be present when running deploy / opennext build):
//   NEXT_PUBLIC_APP_ID
//   NEXT_PUBLIC_WORLD_RECEIVING_WALLET
//   NEXT_PUBLIC_FIREBASE_DATABASE_URL
//
// Pay uses MiniKit.pay (Tokens.USDC) — no USDC contract address in client code.
// Whitelist receiving wallet under Developer Portal → Payments.
