{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "world-arrow-out",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-05-01",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "keep_vars": true,
    "observability": {
        "enabled": false,
        "logs": {
            "enabled": true,
            "persist": true,
            "invocation_logs": true
        }
    },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "world-arrow-out"
        }
    ]
    // All vars & secrets live in Cloudflare Dashboard → Worker → Settings → Variables
    // Plain vars: NEXT_PUBLIC_FIREBASE_*, NEXT_PUBLIC_APP_ID, NEXT_PUBLIC_WORLD_RECEIVING_WALLET
    // Secrets: FIREBASE_DATABASE_SECRET, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,
    //          FIREBASE_DATABASE_URL, DEV_PORTAL_API_KEY
    // Local dev: use .dev.vars (gitignored) — never .env for wrangler
}