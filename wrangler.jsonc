// Root pointer for Cloudflare CI when the project root is the monorepo.
// Prefer setting the Workers build root directory to packages/react-app instead.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "world-arrow-out",
    "main": "packages/react-app/.open-next/worker.js",
    "compatibility_date": "2024-12-30",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "keep_vars": true,
    "vars": {
        "NEXT_PRIVATE_MINIMAL_MODE": "1"
    },
    "assets": {
        "directory": "packages/react-app/.open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "world-arrow-out"
        }
    ]
}
